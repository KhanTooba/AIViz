{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiviz.dev/schema/domain-v1.json",
  "title": "AIViz workspace value domain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "id",
    "name",
    "kind",
    "entry",
    "languages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": "0.2" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": { "const": "value-lattice" },
    "entry": { "type": "string", "pattern": "^\\./.+\\.mjs$" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
