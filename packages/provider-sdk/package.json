{
  "name": "@aiviz/provider-sdk",
  "version": "0.2.0",
  "description": "Helpers for writing an AIViz analysis provider: stdio transport, manifest loading, and a conformance test kit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "aiviz-conformance": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aiviz/trace-protocol": "0.2.0"
  }
}
