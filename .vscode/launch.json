{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AIViz Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.cjs"],
      "preLaunchTask": "build"
    }
  ]
}
