{
  "name": "aiviz",
  "displayName": "AIViz: Abstract Interpretation Visualizer",
  "description": "Step through static-analysis fixpoint computations like a debugger: CFG, abstract states, joins, widening and narrowing.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "aiviz",
  "repository": {
    "type": "git",
    "url": "https://github.com/KhanTooba/AIForToddlers.git"
  },
  "bugs": {
    "url": "https://github.com/KhanTooba/AIForToddlers/issues"
  },
  "homepage": "https://github.com/KhanTooba/AIForToddlers#readme",
  "private": true,
  "icon": "media/icon.png",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Education", "Programming Languages"],
  "keywords": ["abstract interpretation", "static analysis", "cfg", "c", "teaching"],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:llvm-ir",
    "onLanguage:llvm",
    "onCommand:aiviz.analyze",
    "onCommand:aiviz.compare",
    "onCommand:aiviz.loadTrace",
    "onCommand:aiviz.createDomain",
    "onCommand:aiviz.reloadDomains",
    "onCommand:aiviz.showDomainDiagnostics"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "llvm-ir",
        "aliases": ["LLVM IR", "llvm-ir"],
        "extensions": [".ll"]
      }
    ],
    "commands": [
      {
        "command": "aiviz.analyze",
        "title": "AIViz: Analyze Current Function",
        "category": "AIViz",
        "icon": "$(graph)"
      },
      {
        "command": "aiviz.compare",
        "title": "AIViz: Compare Domains",
        "category": "AIViz",
        "icon": "$(diff)"
      },
      {
        "command": "aiviz.next",
        "title": "AIViz: Next Step",
        "category": "AIViz"
      },
      {
        "command": "aiviz.prev",
        "title": "AIViz: Previous Step",
        "category": "AIViz"
      },
      {
        "command": "aiviz.stepOverWidening",
        "title": "AIViz: Step Over to Next Widening",
        "category": "AIViz"
      },
      {
        "command": "aiviz.loadTrace",
        "title": "AIViz: Load Trace From File",
        "category": "AIViz"
      },
      {
        "command": "aiviz.createDomain",
        "title": "AIViz: Create Custom Domain",
        "category": "AIViz",
        "icon": "$(new-file)"
      },
      {
        "command": "aiviz.reloadDomains",
        "title": "AIViz: Reload Domains",
        "category": "AIViz",
        "icon": "$(refresh)"
      },
      {
        "command": "aiviz.showDomainDiagnostics",
        "title": "AIViz: Show Domain Diagnostics",
        "category": "AIViz",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "aiviz.analyze",
          "when": "editorLangId == c || editorLangId == llvm-ir || editorLangId == llvm || resourceExtname == .ll",
          "group": "navigation"
        },
        {
          "command": "aiviz.compare",
          "when": "editorLangId == c || editorLangId == llvm-ir || editorLangId == llvm || resourceExtname == .ll",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiviz.next",
        "key": "f10",
        "when": "aiviz.traceLoaded"
      },
      {
        "command": "aiviz.prev",
        "key": "shift+f10",
        "when": "aiviz.traceLoaded"
      },
      {
        "command": "aiviz.stepOverWidening",
        "key": "f11",
        "when": "aiviz.traceLoaded"
      }
    ],
    "configuration": {
      "title": "AIViz",
      "properties": {
        "aiviz.wideningDelay": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Iterations at a loop header before widening is applied."
        },
        "aiviz.narrowing": {
          "type": "boolean",
          "default": true,
          "description": "Run narrowing passes after widening to recover precision."
        },
        "aiviz.maxIterations": {
          "type": "number",
          "default": 200,
          "description": "Abort the analysis after this many iterations instead of hanging."
        },
        "aiviz.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-run the analysis when the file currently shown in the panel is saved."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Built-in AIViz domains remain available. Workspace-local domain modules are disabled until the workspace is trusted."
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.js",
    "watch": "node build.js --watch",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out aiviz.vsix"
  },
  "dependencies": {
    "@aiviz/trace-protocol": "0.2.0",
    "@dagrejs/dagre": "^1.1.4"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0"
  }
}
